VITE_DEFAULT_TRANSLATION=cuv
VITE_BIBLE_API_BASE=https://bible-api.com
VITE_ENABLE_AI_BG=false

# 生产推荐：图片网关聚合 Pixabay / Pexels / Unsplash，保护密钥并只返回
# 已审核、允许写入 Canvas 后导出的摄影图。例如：https://api.example.com
VITE_IMAGE_GATEWAY_URL=

# 图库目录 · 主源（可选，CDN / GitHub raw）
# VITE_BG_CATALOG_URL=https://cdn.example.com/jinju/background-catalog.json
VITE_BG_CATALOG_URL=

# 图库目录 · 备份源（主源失败时使用）
# VITE_BG_CATALOG_URL_BACKUP=https://mirror.example.com/jinju/background-catalog.json
VITE_BG_CATALOG_URL_BACKUP=

# 换图图库 · 三家免费图库 API Key（可选；配置后优先使用）
VITE_PIXABAY_API_KEY=
VITE_PEXELS_API_KEY=
VITE_UNSPLASH_ACCESS_KEY=
